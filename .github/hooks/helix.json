{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node ./scripts/session-start.js",
        "powershell": "node ./scripts/session-start.js",
        "cwd": ".github/hooks",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "node ./scripts/pet-spawn.js",
        "powershell": "node ./scripts/pet-spawn.js",
        "cwd": ".github/hooks",
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "node ./scripts/pre-tool-use.js",
        "powershell": "node ./scripts/pre-tool-use.js",
        "cwd": ".github/hooks",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "node ./scripts/crg-sweep.js",
        "powershell": "node ./scripts/crg-sweep.js",
        "cwd": ".github/hooks",
        "timeoutSec": 10
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "node ./scripts/crg-sweep.js",
        "powershell": "node ./scripts/crg-sweep.js",
        "cwd": ".github/hooks",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "node ./scripts/derive-trace.js",
        "powershell": "node ./scripts/derive-trace.js",
        "cwd": ".github/hooks",
        "timeoutSec": 30
      },
      {
        "type": "command",
        "bash": "node ./scripts/distill-trigger.js",
        "powershell": "node ./scripts/distill-trigger.js",
        "cwd": ".github/hooks",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "node ./scripts/crg-sweep.js",
        "powershell": "node ./scripts/crg-sweep.js",
        "cwd": ".github/hooks",
        "timeoutSec": 10
      }
    ]
  }
}
