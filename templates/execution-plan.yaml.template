feature: feature-name
status: ready-for-implementation
source:
  refined_intent: workspaces/{workspace-name}/refined-intent.md
  prd: workspaces/{workspace-name}/prd.md                # or prd/index.md for package-first
  tech_design: workspaces/{workspace-name}/tech-design.md  # or tech-design/index.md for package-first

execution:
  mode: ralph-loop            # interactive | ralph-loop | fleet | manual | fast-track
  # manual: human triggers each task individually; no autonomous scheduling

# --- Beta fields (advisory; omit for minimal plans) ---
slices:                        # beta: logical groupings of tasks; verified as a unit
  - id: slice-1
    title: Short slice description
    task_ids: [TASK-001, TASK-002]
    verification:              # beta: gate that must pass before advancing to next slice
      commands:
        - npm test -- --runInBand path/to/slice-tests
      confidence: normal       # normal | degraded | deferred
      on_degraded: defer-and-record   # defer-and-record | block | skip
# --- End beta fields ---

tasks:
  - id: TASK-001
    title: Short task title
    repo: ../path-to-repo
    slice_id: slice-1          # beta: which slice this task belongs to (omit if no slices)
    execution:                 # optional per-task override; required when this task must not inherit root execution.mode
      mode: ralph-loop         # ralph-loop | fleet | manual
    goal: Outcome this task must produce
    priority: P0
    depends_on: []
    can_run_in_parallel: false
    design_refs:
      - tech-design.md#Section
    context_bundle: workspaces/{workspace-name}/context-bundle-TASK-001.md
    ownership:
      write_paths:
        - src/**
      read_paths:
        - src/**
        - tests/**
      shared_contracts: []
    expected_files:
      - src/path/to/file
      - tests/path/to/test
    commands:
      verify:
        - npm test -- --runInBand path/to/test
      focused_test:
        - npm test -- path/to/test
      full_suite:
        - npm test
    verification:              # beta: task-level verification metadata
      confidence: normal       # normal | degraded | deferred
      # degraded: environment could not run commands; follow-up required
      # deferred: verification intentionally skipped; must be resolved before review gate
    acceptance_criteria:
      - Clear, testable acceptance criterion
    done_when:
      - Focused tests pass
      - Expected files exist
    blocker_if:
      - Command cannot be verified
      - Ownership overlaps unresolved task
