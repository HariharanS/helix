# Helix workspace / feature-space manifest
schema_version: 1

id: example-feature
display_name: Example Feature
description: Short description of the feature-space
status: draft
mode: interactive             # interactive | ralph-loop | fleet | manual | fast-track
workflow: full-rpi            # opaque string; today only full-rpi is implemented
objective: One-sentence desired outcome
created_at: 2026-04-10

phase:
  current: setup
  last_completed: null

# Set to true if this workspace touches UI and end-to-end browser tests
# (Playwright) are part of verification. When true, architect routes UI
# tasks through ui-tester (author/debug modes) and the playwright-cli skill
# is loaded. When false, ui-tester and playwright-cli are never loaded.
# Green-path test runs are always executed as plain commands from the
# execution plan, regardless of this flag — the flag only gates LLM
# involvement (test authoring + failure debugging).
ui_verification: false

repos:
  - repo_id: service-a
    role: primary
    branch: main
    focus_areas:
      - src
      - tests

  - repo_id: web-app
    role: supporting
    branch: main
    focus_areas:
      - src/features

artifacts:
  refined_intent: refined-intent.md
  prd: prd/index.md
  tech_design: tech-design/index.md
  task_board_dir: task-boards/
  execution_plan_dir: execution-plans/
  decisions_dir: decisions/
  # verification_policy: verification-policy.yml   # beta: uncomment to enable slice verification policy
